<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controladoras.ControladoraNuevoProducto"
            fitToWidth="true"
            hbarPolicy="NEVER"
            style="-fx-background-color: #fff4e9; -fx-background: #fff4e9; -fx-border-color: transparent;">

    <content>
        <VBox spacing="12.0"
              prefWidth="860.0"
              prefHeight="665.0"
              style="-fx-background-color: #fff4e9;">

            <padding>
                <Insets top="22.0" right="24.0" bottom="18.0" left="24.0"/>
            </padding>

            <!-- Título -->
            <VBox spacing="3.0">
                <Label text="Agregar nuevo producto"
                       style="-fx-font-family: Georgia; -fx-font-size: 23; -fx-font-weight: bold; -fx-text-fill: #8f294d;"/>
                <Label text="Añade un producto al catálogo de la tienda"
                       style="-fx-font-family: Arial; -fx-font-size: 10; -fx-text-fill: #a45f6c;"/>
                <Button text="‹   Volver a productos"
                        onAction="#volver"
                        style="-fx-background-color: transparent; -fx-padding: 3 0; -fx-font-family: Arial; -fx-font-size: 8; -fx-text-fill: #8f294d; -fx-cursor: hand;"/>
            </VBox>

            <!-- Formulario -->
            <VBox spacing="0.0"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #efa9bd; -fx-border-radius: 8;">

                <Label text="Información del producto"
                       style="-fx-padding: 12 14; -fx-font-family: Arial; -fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #82364f; -fx-border-color: transparent transparent #f2d9df transparent;"/>

                <GridPane hgap="18.0" vgap="11.0">
                    <padding>
                        <Insets top="13.0" right="13.0" bottom="13.0" left="13.0"/>
                    </padding>

                    <columnConstraints>
                        <ColumnConstraints percentWidth="59.0"/>
                        <ColumnConstraints percentWidth="41.0"/>
                    </columnConstraints>

                    <!-- Nombre -->
                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Nombre del producto"
                               style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;"/>
                        <TextField fx:id="txtNombre"
                                   prefHeight="30.0"
                                   style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 6 8; -fx-font-family: Arial; -fx-font-size: 9; -fx-text-fill: #713249;"/>
                    </VBox>

                    <!-- Foto -->
                    <VBox spacing="4.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"
                          GridPane.rowSpan="3">
                        <Label text="Foto del producto"
                               style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;"/>
                        <Button fx:id="btnSeleccionarFoto"
                                onAction="#seleccionarFoto"
                                text="▧&#10;Arrastra o haz clic para subir foto"
                                wrapText="true"
                                maxWidth="Infinity"
                                prefHeight="102.0"
                                style="-fx-background-color: #fff8f1; -fx-background-radius: 5; -fx-border-color: #efcfc4; -fx-border-style: dashed; -fx-border-radius: 5; -fx-text-fill: #936877; -fx-font-family: Arial; -fx-font-size: 8; -fx-text-alignment: center; -fx-cursor: hand;"/>
                    </VBox>

                    <!-- Código y marca -->
                    <HBox spacing="10.0"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="1">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Código"
                                   style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;"/>
                            <TextField fx:id="txtCodigo"
                                       promptText="Ej. HB-001"
                                       prefHeight="29.0"
                                       style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 6 8; -fx-font-family: Arial; -fx-font-size: 8;"/>
                        </VBox>

                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Marca"
                                   style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;"/>
                            <TextField fx:id="txtMarca"
                                       promptText="Nombre de la marca"
                                       prefHeight="29.0"
                                       style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 6 8; -fx-font-family: Arial; -fx-font-size: 8;"/>
                        </VBox>
                    </HBox>

                    <!-- Categoría, precio y stock -->
                    <HBox spacing="10.0"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="2">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Categoría"
                                   style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;"/>
                            <ComboBox fx:id="cmbCategoria"
                                      promptText="Seleccionar categoría"
                                      maxWidth="Infinity"
                                      prefHeight="29.0"
                                      style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-font-family: Arial; -fx-font-size: 8;"/>
                        </VBox>

                        <VBox spacing="4.0" prefWidth="88.0">
                            <Label text="Precio"
                                   style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;"/>
                            <HBox alignment="CENTER_LEFT"
                                  spacing="4.0"
                                  prefHeight="29.0"
                                  style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 0 7;">
                                <Label text="\$"
                                       style="-fx-font-family: Arial; -fx-font-size: 8; -fx-text-fill: #8f294d;"/>
                                <TextField fx:id="txtPrecio"
                                           promptText="0"
                                           HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-family: Arial; -fx-font-size: 8;"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="4.0" prefWidth="72.0">
                            <Label text="Stock"
                                   style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;"/>
                            <TextField fx:id="txtStock"
                                       promptText="0"
                                       prefHeight="29.0"
                                       style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 6 8; -fx-font-family: Arial; -fx-font-size: 8;"/>
                        </VBox>
                    </HBox>

                    <!-- Descripción -->
                    <VBox spacing="4.0"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="3">
                        <Label text="Descripción"
                               style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;"/>
                        <TextArea fx:id="txtDescripcion"
                                  promptText="Describe las características del producto"
                                  prefHeight="62.0"
                                  wrapText="true"
                                  style="-fx-control-inner-background: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-font-family: Arial; -fx-font-size: 8;"/>
                    </VBox>

                   
                    <VBox spacing="4.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3">
                        <Label text="URL de la imagen"
                               style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;"/>
                        <TextField fx:id="txtUrlImagen"
                                   promptText="https://..."
                                   prefHeight="29.0"
                                   style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 6 8; -fx-font-family: Arial; -fx-font-size: 8;"/>
                        <Label text="Puedes usar una URL o pegar la dirección."
                               style="-fx-font-family: Arial; -fx-font-size: 7; -fx-text-fill: #9b717b;"/>
                    </VBox>

                    <!-- Etiquetas -->
                    <VBox spacing="4.0"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="4">
                        <Label text="Etiquetas"
                               style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;"/>
                        <TextField fx:id="txtEtiqueta"
                                   promptText="Escribe las etiquetas del producto"
                                   prefHeight="29.0"
                                   style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 6 8; -fx-font-family: Arial; -fx-font-size: 8;"/>
                        <FlowPane fx:id="contenedorEtiquetas" hgap="6.0" vgap="6.0"/>
                        <Label text="Separa las etiquetas con comas."
                               style="-fx-font-family: Arial; -fx-font-size: 7; -fx-text-fill: #9b717b;"/>
                    </VBox>

                    <!-- Disponibilidad -->
                    <HBox alignment="CENTER_LEFT"
                          spacing="8.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="4"
                          style="-fx-background-color: #fff8f1; -fx-background-radius: 5; -fx-padding: 9;">
                        <VBox spacing="3.0">
                            <Label text="Disponible"
                                   style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;"/>
                            <Label text="Disponible para la venta"
                                   style="-fx-font-family: Arial; -fx-font-size: 7; -fx-text-fill: #9b717b;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <CheckBox fx:id="chkDisponible" selected="true"/>
                    </HBox>
                </GridPane>

                <!-- Botones -->
                <HBox alignment="CENTER_RIGHT"
                      spacing="9.0"
                      style="-fx-padding: 9 12; -fx-border-color: #f2d9df transparent transparent transparent;">
                    <Button fx:id="btnCancelar"
                            text="Cancelar"
                            onAction="#volver"
                            prefWidth="90.0"
                            prefHeight="30.0"
                            style="-fx-background-color: #fff8f1; -fx-background-radius: 5; -fx-border-color: #d9a9b7; -fx-border-radius: 5; -fx-text-fill: #78304a; -fx-font-family: Arial; -fx-font-size: 8; -fx-cursor: hand;"/>
                    <Button fx:id="btnCrearProducto"
                            text="Crear producto"
                            onAction="#crearProducto"
                            prefWidth="112.0"
                            prefHeight="30.0"
                            style="-fx-background-color: #f3469a; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
