<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="780.0" prefWidth="1100.0" style="-fx-background-color: #fff4e9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controladoras.ControladoraAdmin">
   <stylesheets>
      <URL value="@admin.css" />
   </stylesheets>
   <top>
      <VBox>
         <children>
   
            <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: transparent;">
               <padding>
                  <Insets bottom="10.0" left="40.0" right="40.0" top="10.0" />
               </padding>
               <children>
                  <ImageView fitHeight="60.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../imagenes/logo-hada.png" />
                     </image>
                  </ImageView>
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0" style="-fx-background-color: #ffc6ad; -fx-background-radius: 20; -fx-border-color: #ff806d; -fx-border-radius: 20;">
                     <padding>
                        <Insets left="10.0" right="20.0" />
                     </padding>
                     <children>
                        <Label alignment="CENTER" prefHeight="36.0" prefWidth="36.0" style="-fx-background-color: #fff4e9; -fx-background-radius: 50; -fx-text-fill: #8f294d; -fx-font-size: 16;" text="👤" />
                        <Label fx:id="lblAdmin" style="-fx-font-family: arial; -fx-font-size: 15; -fx-text-fill: #8f294d;" text="Administrador" />
                        <Region prefHeight="28.0" prefWidth="1.0" style="-fx-background-color: #e59a8a;" />
                        <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#cerrarSesion" style="-fx-background-color: transparent; -fx-font-family: arial; -fx-font-size: 15; -fx-text-fill: #8f294d; -fx-cursor: hand;" text="↪  Cerrar sesión" />
                     </children>
                  </HBox>
               </children>
            </HBox>
            <Separator />
            
            <HBox alignment="CENTER_LEFT" prefHeight="35.0" spacing="12.0">
               <padding>
                  <Insets left="90.0" right="40.0" />
               </padding>
               <children>
                  <Button mnemonicParsing="false" onAction="#irProductos" style="-fx-background-color: #f3d9cc; -fx-background-radius: 6; -fx-font-family: arial; -fx-font-size: 11; -fx-text-fill: #8f294d; -fx-cursor: hand;" text="▣  Productos" />
                  <Button mnemonicParsing="false" onAction="#irPedidos" style="-fx-background-color: transparent; -fx-font-family: arial; -fx-font-size: 11; -fx-text-fill: #8f294d; -fx-cursor: hand;" text="🛍  Pedidos" />
                  <Button mnemonicParsing="false" onAction="#irUsuarios" style="-fx-background-color: transparent; -fx-font-family: arial; -fx-font-size: 11; -fx-text-fill: #8f294d; -fx-cursor: hand;" text="👥  Usuarios" />
                  <Button mnemonicParsing="false" onAction="#irMiPerfil" style="-fx-background-color: transparent; -fx-font-family: arial; -fx-font-size: 11; -fx-text-fill: #8f294d; -fx-cursor: hand;" text="👤  Mi perfil" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#verTienda" style="-fx-background-color: transparent; -fx-font-family: arial; -fx-font-size: 11; -fx-text-fill: #8f294d; -fx-cursor: hand;" text="Ver tienda ↗" />
               </children>
            </HBox>
            <Separator />
         </children>
      </VBox>
   </top>
   <left>
      <!-- Panel blanco con el botón Productos -->
      <VBox prefWidth="290.0" style="-fx-background-color: #ffffff; -fx-background-radius: 25;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="25.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="30.0" left="30.0" right="10.0" top="25.0" />
         </BorderPane.margin>
         <children>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irProductos" prefHeight="60.0" style="-fx-background-color: #f7b2a6; -fx-border-color: #ff806d; -fx-background-radius: 20; -fx-border-radius: 20; -fx-font-family: georgia; -fx-font-size: 24; -fx-text-fill: #8f294d; -fx-cursor: hand;" text="▣   Productos" />
         </children>
      </VBox>
   </left>
   <center>
      <!-- Zona principal: título, buscador y tabla -->
      <VBox spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="30.0" left="20.0" right="40.0" top="20.0" />
         </padding>
         <children>
            <Label style="-fx-font-family: georgia; -fx-font-size: 46; -fx-font-weight: bold; -fx-text-fill: #8f294d;" text="Gestionar productos" />
            <Label style="-fx-font-family: arial; -fx-font-size: 16; -fx-text-fill: #8f294d;" text="Administra el catálogo de la tienda">
               <VBox.margin>
                  <Insets left="40.0" />
               </VBox.margin>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="30.0">
               <VBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </VBox.margin>
               <children>
                  <TextField fx:id="txtBuscar" onKeyReleased="#buscarProducto" prefHeight="45.0" promptText="🔍   Buscar producto..." style="-fx-background-color: #ffc6ad; -fx-background-radius: 15; -fx-border-color: #ff806d; -fx-border-radius: 15; -fx-font-family: arial; -fx-font-size: 14; -fx-text-fill: #8f294d; -fx-prompt-text-fill: #ffffff;" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnNuevoProducto" mnemonicParsing="false" onAction="#nuevoProducto" prefHeight="45.0" style="-fx-background-color: #ff4f9a; -fx-background-radius: 15; -fx-font-family: arial; -fx-font-size: 14; -fx-text-fill: #ffffff; -fx-cursor: hand;" text="＋  Nuevo producto" />
               </children>
            </HBox>
            <TableView fx:id="tablaProductos" styleClass="tabla-admin" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colImagen" prefWidth="105.0" sortable="false" style="-fx-alignment: CENTER;" text="Imagen" />
                  <TableColumn fx:id="colNombre" prefWidth="250.0" style="-fx-alignment: CENTER-LEFT;" text="Nombre/Descripción" />
                  <TableColumn fx:id="colCategoria" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Categoría" />
                  <TableColumn fx:id="colPrecio" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Precio" />
                  <TableColumn fx:id="colAcciones" prefWidth="105.0" sortable="false" style="-fx-alignment: CENTER;" text="Acciones" />
               </columns>
               <placeholder>
                  <Label style="-fx-font-family: georgia; -fx-font-size: 15; -fx-text-fill: #8f294d;" text="Aún no hay productos para mostrar" />
               </placeholder>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
