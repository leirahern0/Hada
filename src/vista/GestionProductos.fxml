<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controladoras.ControladoraGestionProductos" spacing="14"
      style="-fx-background-color: #fff4e9;" prefWidth="865" prefHeight="665">
    <padding><Insets top="20" right="25" bottom="18" left="25"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="3">
            <Label text="Gestionar productos" style="-fx-font-family: Georgia; -fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #8f294d;"/>
            <Label text="Administra el catálogo de tu tienda" style="-fx-font-size: 12; -fx-text-fill: #ff806d;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="＋  Nuevo producto" onAction="#nuevoProducto" style="-fx-background-color: #ff4f9a; -fx-background-radius: 9; -fx-padding: 10 16; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #ffc6ad; -fx-border-radius: 16;">
        <padding><Insets top="14" right="16" bottom="12" left="16"/></padding>
        <TextField fx:id="txtBuscar" promptText="🔍   Buscar producto..." onKeyReleased="#buscarProducto"
                   style="-fx-background-color: #fff4e9; -fx-background-radius: 8; -fx-border-color: #ffc6ad; -fx-border-radius: 8; -fx-padding: 9;"/>
        <HBox spacing="8">
            <Button text="Todos" onAction="#filtroTodos" style="-fx-background-color: #ffc6ad; -fx-background-radius: 18; -fx-text-fill: #8f294d;"/>
            <Button text="Rostro" onAction="#filtroRostro" style="-fx-background-color: #fff4e9; -fx-background-radius: 18; -fx-text-fill: #8f294d;"/>
            <Button text="Labios" onAction="#filtroLabios" style="-fx-background-color: #fff4e9; -fx-background-radius: 18; -fx-text-fill: #8f294d;"/>
            <Button text="Ojos" onAction="#filtroOjos" style="-fx-background-color: #fff4e9; -fx-background-radius: 18; -fx-text-fill: #8f294d;"/>
        </HBox>
        <GridPane style="-fx-background-color: #fff4e9; -fx-padding: 9 8;" hgap="8">
            <columnConstraints>
                <ColumnConstraints percentWidth="9"/><ColumnConstraints percentWidth="38"/>
                <ColumnConstraints percentWidth="17"/><ColumnConstraints percentWidth="13"/>
                <ColumnConstraints percentWidth="23"/>
            </columnConstraints>
            <children>
                <Label text="Imagen" GridPane.columnIndex="0"/><Label text="Nombre / Descripción" GridPane.columnIndex="1"/>
                <Label text="Categoría" GridPane.columnIndex="2"/><Label text="Precio" GridPane.columnIndex="3"/>
                <Label text="Acciones" GridPane.columnIndex="4"/>
            </children>
        </GridPane>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <content><VBox fx:id="contenedorProductos" spacing="0" style="-fx-background-color: white;"/></content>
        </ScrollPane>
        <Label fx:id="lblContador" text="Mostrando 0 productos" style="-fx-font-size: 10; -fx-text-fill: #ff806d;"/>
    </VBox>
</VBox>
