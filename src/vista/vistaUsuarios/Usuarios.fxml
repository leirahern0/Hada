<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.ColorAdjust?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<BorderPane
    prefHeight="700.0"
    prefWidth="900.0"
    maxHeight="1.7976931348623157E308"
    maxWidth="1.7976931348623157E308"
    style="-fx-background-color: #fff4e9;"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="Controladoras.EntornoUsuario.ControladoraUsuario">

    <center>

        <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            maxHeight="1.7976931348623157E308"
            maxWidth="1.7976931348623157E308">

            <content>

                <VBox
                    alignment="TOP_CENTER"
                    minWidth="0"
                    maxWidth="Infinity"
                    spacing="0">

                    <children>

                        <!-- ENCABEZADO -->

                        <HBox
                            maxWidth="Infinity"
                            prefHeight="70.0"
                            style="-fx-border-color: #C5C5C5;
                                   -fx-background-color: #fff4e9;">

                            <children>

                                <ImageView
                                    fitHeight="70.0"
                                    pickOnBounds="true"
                                    preserveRatio="true">

                                    <image>
                                        <Image url="@../../imagenes/LogoHada.png"/>
                                    </image>

                                </ImageView>

                                <Region
                                    prefWidth="47.0"
                                    style="-fx-background-color: #fff4e9;"/>

                                <HBox maxWidth="Infinity" prefWidth="400.0" HBox.hgrow="ALWAYS">

                                    <children>

                                        <TextField
                                            fx:id="txtBuscar"
                                            onAction="#buscarProducto"
                                            prefHeight="30.0"
                                            prefWidth="400.0"
                                            maxWidth="Infinity"
                                            promptText="Buscar productos"
                                            HBox.hgrow="ALWAYS"
                                            style="-fx-border-color: #FF4F9A;
                                                   -fx-background-color: #FFF0E1;
                                                   -fx-border-radius: 30;">

                                            <HBox.margin>
                                                <Insets top="20.0"/>
                                            </HBox.margin>

                                        </TextField>

                                    </children>

                                </HBox>

                                <Button
                                    alignment="CENTER"
                                    contentDisplay="GRAPHIC_ONLY"
                                    mnemonicParsing="false"
                                    onAction="#buscarProducto"
                                    style="-fx-background-color: #FFC6AD;
                                           -fx-background-radius: 50;
                                           -fx-border-color: #FFC6AD;
                                           -fx-border-radius: 50;
                                           -fx-border-width: 1;">

                                    <HBox.margin>
                                        <Insets left="5.0" top="20.0"/>
                                    </HBox.margin>

                                    <graphic>

                                        <ImageView
                                            fitHeight="15.0"
                                            fitWidth="15.0"
                                            preserveRatio="true">

                                            <image>
                                                <Image url="@../../imagenes/search.png"/>
                                            </image>

                                            <effect>
                                                <ColorAdjust/>
                                            </effect>

                                        </ImageView>

                                    </graphic>

                                </Button>

                                <Region prefWidth="76.0"/>

                                <!-- FAVORITOS -->

                                <Button
                                    mnemonicParsing="false"
                                    onAction="#abrirFavoritos"
                                    style="-fx-background-color: transparent;">

                                    <graphic>
                                        <ImageView
                                            fitHeight="20.0"
                                            fitWidth="20.0"
                                            preserveRatio="true">

                                            <image>
                                                <Image url="@../../imagenes/heart.png"/>
                                            </image>

                                        </ImageView>
                                    </graphic>

                                    <HBox.margin>
                                        <Insets top="20.0"/>
                                    </HBox.margin>

                                </Button>

                                <!-- PERFIL -->

                                <Button
                                    mnemonicParsing="false"
                                    onAction="#abrirPerfil"
                                    style="-fx-background-color: transparent;">

                                    <graphic>
                                        <ImageView
                                            fitHeight="20.0"
                                            fitWidth="20.0"
                                            preserveRatio="true">

                                            <image>
                                                <Image url="@../../imagenes/circle-user.png"/>
                                            </image>

                                        </ImageView>
                                    </graphic>

                                    <HBox.margin>
                                        <Insets top="20.0"/>
                                    </HBox.margin>

                                </Button>

                                <!-- CARRITO -->

                                <Button
                                    fx:id="btnCarrito"
                                    mnemonicParsing="false"
                                    onAction="#abrirCarrito"
                                    style="-fx-background-color: transparent;">

                                    <graphic>
                                        <ImageView
                                            fitHeight="20.0"
                                            fitWidth="20.0"
                                            preserveRatio="true">

                                            <image>
                                                <Image url="@../../imagenes/shopping-cart.png"/>
                                            </image>

                                        </ImageView>
                                    </graphic>

                                    <HBox.margin>
                                        <Insets top="20.0"/>
                                    </HBox.margin>

                                </Button>

                            </children>

                        </HBox>


                        <!-- BANNER PRINCIPAL -->

                        <HBox
                            fx:id="contenedorBanner"
                            alignment="CENTER"
                            maxWidth="Infinity"
                            prefHeight="234.0"
                            minHeight="170.0"
                            style="-fx-background-color: #FF806D;">

                            <children>

                                <ImageView
                                    fx:id="imagenBanner"
                                    fitHeight="234.0"
                                    fitWidth="726.0"
                                    pickOnBounds="true"
                                    preserveRatio="true">

                                    <image>
                                        <Image url="@../../imagenes/Banner.png"/>
                                    </image>

                                </ImageView>

                            </children>

                        </HBox>


                        <!-- SECCIÓN DE CATEGORÍAS -->

                        <AnchorPane
                            fx:id="contenedorVistas"
                            minWidth="0"
                            prefHeight="225.0"
                            minHeight="225.0"
                            maxWidth="Infinity"
                            style="-fx-background-color: #fff4e9;">

                            <children>

                                <!-- TÍTULO -->

                                <Label
                                    fx:id="lblTituloCategorias"
                                    layoutX="335.0"
                                    layoutY="23.0"
                                    style="-fx-font-family: georgia;
                                           -fx-font-size: 16;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #8F294D;"
                                    text="Explora nuestros productos"/>

                                <!-- LÍNEAS DECORATIVAS -->

                                <Line
                                    fx:id="lineaCategoriasIzquierda"
                                    endX="100.0"
                                    layoutX="675.0"
                                    layoutY="41.0"
                                    startX="-100.0"
                                    stroke="#8f294d"/>

                                <Line
                                    fx:id="lineaCategoriasDerecha"
                                    endX="100.0"
                                    layoutX="224.0"
                                    layoutY="42.0"
                                    startX="-100.0"
                                    stroke="#8f294d"/>


                                <!-- CATEGORÍA LABIOS -->

                                <Button
                                    fx:id="btnCategoriaLabios"
                                    layoutX="98.0"
                                    layoutY="80.0"
                                    onAction="#filtroLabios"
                                    mnemonicParsing="false"
                                    style="-fx-background-radius: 50;
                                           -fx-border-radius: 50;
                                           -fx-background-color: transparent;">

                                    <graphic>
                                        <ImageView
                                            fitHeight="68.0"
                                            fitWidth="68.0"
                                            preserveRatio="true">

                                            <image>
                                                <Image url="@../../imagenes/Labios.png"/>
                                            </image>

                                        </ImageView>
                                    </graphic>

                                </Button>

                                <!-- CATEGORÍA ROSTRO -->

                                <Button
                                    fx:id="btnCategoriaRostro"
                                    layoutX="300.0"
                                    layoutY="80.0"
                                    onAction="#filtroRostro"
                                    mnemonicParsing="false"
                                    style="-fx-background-radius: 50;
                                           -fx-border-radius: 50;
                                           -fx-background-color: transparent;">

                                    <graphic>
                                        <ImageView
                                            fitHeight="68.0"
                                            fitWidth="68.0"
                                            preserveRatio="true">

                                            <image>
                                                <Image url="@../../imagenes/Rostro.png"/>
                                            </image>

                                        </ImageView>
                                    </graphic>

                                </Button>

                                <!-- CATEGORÍA OJOS -->

                                <Button
                                    fx:id="btnCategoriaOjos"
                                    layoutX="530.0"
                                    layoutY="80.0"
                                    onAction="#filtroOjos"
                                    mnemonicParsing="false"
                                    style="-fx-background-radius: 50;
                                           -fx-border-radius: 50;
                                           -fx-background-color: transparent;">

                                    <graphic>
                                        <ImageView
                                            fitHeight="68.0"
                                            fitWidth="68.0"
                                            preserveRatio="true">

                                            <image>
                                                <Image url="@../../imagenes/Ojos.png"/>
                                            </image>

                                        </ImageView>
                                    </graphic>

                                </Button>

                                <!-- CATEGORÍA BROCHAS -->

                                <Button
                                    fx:id="btnCategoriaBrochas"
                                    layoutX="734.0"
                                    layoutY="80.0"
                                    onAction="#filtroBrochas"
                                    mnemonicParsing="false"
                                    style="-fx-background-radius: 50;
                                           -fx-border-radius: 50;
                                           -fx-background-color: transparent;">

                                    <graphic>
                                        <ImageView
                                            fitHeight="68.0"
                                            fitWidth="68.0"
                                            preserveRatio="true">

                                            <image>
                                                <Image url="@../../imagenes/Brochas.png"/>
                                            </image>

                                        </ImageView>
                                    </graphic>

                                </Button>


                                <!-- NOMBRES DE CATEGORÍAS -->

                                <Label
                                    fx:id="lblCategoriaLabios"
                                    layoutX="116.0"
                                    layoutY="156.0"
                                    style="-fx-text-fill: #8f294d;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 12;
                                           -fx-font-family: arial;"
                                    text="Labios"/>

                                <Label
                                    fx:id="lblCategoriaRostro"
                                    layoutX="320.0"
                                    layoutY="156.0"
                                    style="-fx-text-fill: #8f294d;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 12;
                                           -fx-font-family: arial;"
                                    text="Rostro"/>

                                <Label
                                    fx:id="lblCategoriaOjos"
                                    layoutX="556.0"
                                    layoutY="156.0"
                                    style="-fx-text-fill: #8f294d;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 12;
                                           -fx-font-family: arial;"
                                    text="Ojos"/>

                                <Label
                                    fx:id="lblCategoriaBrochas"
                                    layoutX="720.0"
                                    layoutY="156.0"
                                    style="-fx-text-fill: #8f294d;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 12;
                                           -fx-font-family: arial;"
                                    text="Brochas y accesorios"/>


                                <!-- BOTÓN VER TODO -->

                                <Button
                                    fx:id="btnVerTodo"
                                    layoutX="743.0"
                                    layoutY="188.0"
                                    prefHeight="27.0"
                                    prefWidth="101.0"
                                    onAction="#verTodos"
                                    mnemonicParsing="false"
                                    style="-fx-background-color: #FF4F9A;
                                           -fx-text-fill: white;
                                           -fx-border-radius: 20;
                                           -fx-background-radius: 20;
                                           -fx-cursor: hand;
                                           -fx-font-size: 13;
                                           -fx-font-weight: bold;"
                                    text="VER TODO"/>

                            </children>

                        </AnchorPane>


                        <!-- CONTENEDOR DE PRODUCTOS -->

                        <FlowPane
                            fx:id="contenedorProductos"
                            alignment="TOP_CENTER"
                            minWidth="0"
                            maxWidth="Infinity"
                            hgap="12.0"
                            vgap="20.0"
                            style="-fx-background-color: #fff4e9;">

                            <padding>
                                <Insets
                                    bottom="25.0"
                                    left="20.0"
                                    right="20.0"
                                    top="15.0"/>
                            </padding>

                        </FlowPane>

                    </children>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>
