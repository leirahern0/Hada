<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" stylesheets="@../Tienda.css" style="-fx-background: #fff4e9; -fx-background-color: #fff4e9; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controladoras.EntornoUsuario.ControladoraTerminarPedido">
    <content>
        <StackPane alignment="TOP_CENTER" style="-fx-background-color: #fff4e9;">
            <children>
                <VBox fx:id="raiz" maxWidth="900.0" prefWidth="900.0" spacing="14.0">
                    <children>
                        <VBox spacing="2.0">
                            <VBox.margin>
                                <Insets left="24.0" right="24.0" top="18.0" />
                            </VBox.margin>
                            <children>
                                <Label style="-fx-font-family: Georgia; -fx-font-weight: bold; -fx-font-size: 24; -fx-text-fill: #ff4f9a;" text="TERMINA TU PEDIDO" />
                                <Button onAction="#volverCarrito" styleClass="btn-enlace" style="-fx-padding: 0;" text="← Volver al carrito" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0" styleClass="tarjeta">
                            <VBox.margin>
                                <Insets left="24.0" right="24.0" />
                            </VBox.margin>
                            <children>
                                <Label styleClass="seccion" text="DATOS PERSONALES" />
                                <Label styleClass="etiqueta" text="Correo" />
                                <TextField fx:id="txtCorreo" styleClass="campo" />
                                <GridPane hgap="16.0" vgap="8.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50.0" />
                                        <ColumnConstraints percentWidth="50.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label styleClass="etiqueta" text="Nombre(s)" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="txtNombres" maxWidth="Infinity" styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <Label styleClass="etiqueta" text="Apellido(s)" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                        <TextField fx:id="txtApellidos" maxWidth="Infinity" styleClass="campo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        <Label styleClass="etiqueta" text="Tipo de documento" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <ComboBox fx:id="cmbTipoDocumento" maxWidth="Infinity" promptText="Selecciona" styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                        <Label styleClass="etiqueta" text="Documento" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtDocumento" maxWidth="Infinity" styleClass="campo" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    </children>
                                </GridPane>
                                <Label styleClass="etiqueta" text="Celular" />
                                <TextField fx:id="txtCelular" styleClass="campo" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0" styleClass="tarjeta">
                            <VBox.margin>
                                <Insets left="24.0" right="24.0" />
                            </VBox.margin>
                            <children>
                                <Label styleClass="seccion" text="ENTREGA Y PAGO" />
                                <Label styleClass="etiqueta" text="Dirección de entrega" />
                                <TextField fx:id="txtDireccion" promptText="Calle, número y complemento" styleClass="campo" />
                                <Label styleClass="etiqueta" text="Ciudad" />
                                <TextField fx:id="txtCiudad" styleClass="campo" />
                                <Label styleClass="etiqueta" text="Método de pago" />
                                <ComboBox fx:id="cmbMetodoPago" maxWidth="Infinity" promptText="Selecciona" styleClass="campo" />
                            </children>
                        </VBox>

                        <VBox spacing="10.0">
                            <VBox.margin>
                                <Insets bottom="28.0" left="24.0" right="24.0" />
                            </VBox.margin>
                            <children>
                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                    <children>
                                        <Label fx:id="lblResumen" styleClass="subtitulo" text="0 productos" />
                                        <Label styleClass="etiqueta" text="Total:" />
                                        <Label fx:id="lblTotal" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #ff4f9a;" text="0" />
                                    </children>
                                </HBox>
                                <Button maxWidth="Infinity" onAction="#confirmarPedido" styleClass="btn-rosa" text="Confirmar pedido" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </content>
</ScrollPane>
