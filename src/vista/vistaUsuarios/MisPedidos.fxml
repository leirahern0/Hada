<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  MIS PEDIDOS (usuario) - se pega en el center de la ventana del usuario.

  fx:id que la controladora debe declarar (@FXML):
    btnTabPedidos, btnTabHistorial   (para cambiar el color de la pestaña activa)
    contenedorPedidos                (VBox VACÍO: aquí se agregan por código las tarjetas de pedido)
    panelVacio                       (se muestra cuando no hay pedidos que listar)

  Métodos que la controladora debe tener (@FXML):
    volver, verPedidosActivos, verHistorial, explorarProductos
-->
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #fff4e9; -fx-background-color: #fff4e9; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controladoras.ControladoraMisPedidos">
   <content>
      <StackPane alignment="TOP_CENTER" style="-fx-background-color: #fff4e9;">
         <children>
            <VBox maxWidth="900.0" prefWidth="900.0" spacing="16.0">
               <padding>
                  <Insets bottom="28.0" left="24.0" right="24.0" top="24.0" />
               </padding>
               <children>

                  <VBox spacing="2.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <Label onMouseClicked="#volver" style="-fx-font-size: 24; -fx-text-fill: #8f294d; -fx-cursor: hand;" text="←" />
                              <Label style="-fx-font-family: Georgia; -fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #8f294d;" text="Mis pedidos" />
                           </children>
                        </HBox>
                        <Label style="-fx-font-size: 12; -fx-text-fill: #8f294d; -fx-padding: 0 0 0 36;" text="Consulta tus compras y su estado." />
                     </children>
                  </VBox>

                  <VBox fx:id="contenedorPedidos" minHeight="260.0" spacing="12.0" />

                  <VBox fx:id="panelVacio" alignment="CENTER" managed="false" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #f2d9df; -fx-border-radius: 14; -fx-padding: 36 20 36 20;" visible="false">
                     <children>
                        <Label style="-fx-font-size: 30;" text="🛍" />
                        <Label style="-fx-font-family: Georgia; -fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #8f294d;" text="Aún no tienes pedidos" />
                        <Label style="-fx-font-size: 11; -fx-text-fill: #9b717b;" text="Cuando hagas una compra, la verás aquí con su estado." />
                        <Button mnemonicParsing="false" onAction="#explorarProductos" style="-fx-background-color: #ff4f9a; -fx-background-radius: 20; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12; -fx-padding: 8 24 8 24; -fx-cursor: hand;" text="Explorar productos" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </content>
</ScrollPane>

