<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #fff4e9; -fx-background: #fff4e9; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controladoras.ControladoraNuevoProducto">

    <content>
        <VBox prefHeight="665.0" prefWidth="860.0" spacing="12.0" style="-fx-background-color: #fff4e9;">

            <padding>
                <Insets bottom="18.0" left="24.0" right="24.0" top="22.0" />
            </padding>

            <!-- Título -->
            <VBox spacing="3.0">
                <Label style="-fx-font-family: Georgia; -fx-font-size: 23; -fx-font-weight: bold; -fx-text-fill: #8f294d;" text="Agregar nuevo producto" />
                <Label style="-fx-font-family: Arial; -fx-font-size: 10; -fx-text-fill: #a45f6c;" text="Añade un producto al catálogo de la tienda" />
                <Button onAction="#volver" style="-fx-background-color: transparent; -fx-padding: 3 0; -fx-font-family: Arial; -fx-font-size: 8; -fx-text-fill: #8f294d; -fx-cursor: hand;" text="‹   Volver a productos" />
            </VBox>

            <!-- Formulario -->
            <VBox spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #efa9bd; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">

                <Label style="-fx-padding: 12 14; -fx-font-family: Arial; -fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #82364f; -fx-border-color: transparent transparent #f2d9df transparent;" text="Información del producto" />

                <GridPane hgap="18.0" vgap="11.0">
                    <padding>
                        <Insets bottom="13.0" left="13.0" right="13.0" top="13.0" />
                    </padding>

                    <columnConstraints>
                        <ColumnConstraints percentWidth="59.0" />
                        <ColumnConstraints percentWidth="41.0" />
                    </columnConstraints>

                    <!-- Nombre -->
                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;" text="Nombre del producto" />
                        <TextField fx:id="txtNombre" prefHeight="30.0" style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 6 8; -fx-font-family: Arial; -fx-font-size: 9; -fx-text-fill: #713249;" />
                    </VBox>

                    
                    <!-- Foto -->
                    <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.rowSpan="3">

                        <Label style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;" text="Foto del producto" />

                        <ImageView fx:id="vistaImagen" fitHeight="110.0" fitWidth="130.0" preserveRatio="true" />

                        <Button fx:id="btnSeleccionarFoto" maxWidth="Infinity" onAction="#elegirFotoVistaImagen" prefHeight="40.0" style="-fx-background-color: #fff8f1; -fx-background-radius: 5; -fx-border-color: #efcfc4; -fx-border-style: dashed; -fx-border-radius: 5; -fx-text-fill: #936877; -fx-font-family: Arial; -fx-font-size: 8;" text="Seleccionar fotografía" wrapText="true" />
                    </VBox>
                    
                    <!-- Código y marca -->
                    <HBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;" text="Código" />
                            <TextField fx:id="txtCodigo" prefHeight="29.0" promptText="Ej. HB-001" style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 6 8; -fx-font-family: Arial; -fx-font-size: 8;" />
                        </VBox>

                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;" text="Marca" />
                            <TextField fx:id="txtMarca" prefHeight="29.0" promptText="Nombre de la marca" style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 6 8; -fx-font-family: Arial; -fx-font-size: 8;" />
                        </VBox>
                    </HBox>

                    <!-- Categoría, precio y stock -->
                    <HBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;" text="Categoría" />
                            <ComboBox fx:id="cmbCategoria" maxWidth="Infinity" prefHeight="29.0" promptText="Seleccionar categoría" style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-font-family: Arial; -fx-font-size: 8;" />
                        </VBox>

                        <VBox prefWidth="88.0" spacing="4.0">
                            <Label style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;" text="Precio" />
                            <HBox alignment="CENTER_LEFT" prefHeight="29.0" spacing="4.0" style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 0 7;">
                                <Label style="-fx-font-family: Arial; -fx-font-size: 8; -fx-text-fill: #8f294d;" text="\$" />
                                <TextField fx:id="txtPrecio" promptText="0" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-family: Arial; -fx-font-size: 8;" HBox.hgrow="ALWAYS" />
                            </HBox>
                        </VBox>

                        <VBox prefWidth="72.0" spacing="4.0">
                            <Label style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;" text="Stock" />
                            <TextField fx:id="txtStock" prefHeight="29.0" promptText="0" style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 6 8; -fx-font-family: Arial; -fx-font-size: 8;" />
                        </VBox>
                    </HBox>

                    
                    <!-- Descripción -->
                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="3">

                        <Label style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;" text="Descripción" />

                        <TextArea fx:id="txtDescripcion" prefHeight="62.0" promptText="Describe las características del producto" style="-fx-control-inner-background: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-font-family: Arial; -fx-font-size: 8;" wrapText="true" />
                    </VBox>

                   
                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <children>
                            <Region />
      
                            <!-- Disponibilidad -->
                            <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #fff8f1; -fx-background-radius: 5; -fx-padding: 9;">
                                <VBox spacing="3.0">
                                    <Label style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;" text="Disponible" />
                                    <Label style="-fx-font-family: Arial; -fx-font-size: 7; -fx-text-fill: #9b717b;" text="Disponible para la venta" />
                                </VBox>
                                <CheckBox fx:id="chkDisponible" selected="true" />
                            </HBox>
                        </children>
                    </VBox>

                    <!-- Etiquetas -->
                    <VBox spacing="4.0" GridPane.rowIndex="4">
                        <Label style="-fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-text-fill: #713249;" text="Etiquetas" />
                        <TextField fx:id="txtEtiqueta" prefHeight="29.0" promptText="Escribe las etiquetas del producto" style="-fx-background-color: #fff8f1; -fx-background-radius: 4; -fx-border-color: #f1d5ca; -fx-border-radius: 4; -fx-padding: 6 8; -fx-font-family: Arial; -fx-font-size: 8;" />
                        <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" prefHeight="32.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER">
                            <HBox fx:id="contenedorEtiquetas" alignment="CENTER_LEFT" spacing="6.0" />
                        </ScrollPane>
                        <Label style="-fx-font-family: Arial; -fx-font-size: 7; -fx-text-fill: #9b717b;" text="Separa las etiquetas con comas." />
                    </VBox>
                    <Button fx:id="btnAgregarEt" onAction="#agregarEtiqueta" prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #f3469a; -fx-background-radius: 5; -fx-border-radius: 5; -fx-text-fill: white; -fx-font-family: Arial; -fx-font-size: 8; -fx-cursor: hand;" text="Agregar" GridPane.columnIndex="1" GridPane.rowIndex="4">
                  <font>
                     <Font size="24.0" />
                  </font></Button>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>

                <!-- Botones -->
                <HBox alignment="CENTER_RIGHT" spacing="9.0" style="-fx-padding: 9 12; -fx-border-color: #f2d9df transparent transparent transparent;">
                    <Button fx:id="btnCancelar" onAction="#volver" prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #fff8f1; -fx-background-radius: 5; -fx-border-color: #d9a9b7; -fx-border-radius: 5; -fx-text-fill: #78304a; -fx-font-family: Arial; -fx-font-size: 8; -fx-cursor: hand;" text="Cancelar" />
                    <Button fx:id="btnCrearProducto" onAction="#crearProducto" prefHeight="30.0" prefWidth="112.0" style="-fx-background-color: #f3469a; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-family: Arial; -fx-font-size: 8; -fx-font-weight: bold; -fx-cursor: hand;" text="Crear producto" />
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
