<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controladoras.ControladoraEditarProducto">
    <VBox spacing="0" style="-fx-background-color: #FFF6EC; -fx-padding: 20 24 0 24;">

        <!-- ENCABEZADO IGUAL A LA FOTO -->
        <VBox spacing="2">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #7A1C33;" text="Editar producto" />
            <Label style="-fx-font-size: 11px; -fx-text-fill: #8A7A72;" text="Modifica los datos guardados de este producto" />
            <Label fx:id="lblVolver" onMouseClicked="#volver" style="-fx-font-size: 11px; -fx-text-fill: #7A1C33; -fx-cursor: hand; -fx-padding: 4 0 12 0;" text="‹ Volver a productos" />
        </VBox>

        <!-- TARJETA BLANCA PRINCIPAL -->
        <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-color: #F5D6DE; -fx-border-width: 1 0 1 0; -fx-padding: 16 18 18 18;">

            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;" text="Información del producto" />

            <GridPane hgap="22" vgap="14">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="66" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="34" />
                </columnConstraints>

                <!-- COLUMNA IZQUIERDA - FORMULARIO -->
                <VBox spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;" text="Nombre del producto" />
                        <TextField fx:id="txtNombre" style="-fx-background-color: #FFF6EC; -fx-background-radius: 6; -fx-border-color: #F2DDD0; -fx-border-radius: 6; -fx-padding: 9 10 9 10; -fx-font-size: 12px;" text="Base de maquillaje - Fit Me" />
                    </VBox>

                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;" text="Código" />
                            <TextField fx:id="txtCodigo" editable="false" promptText="Sin código asignado" style="-fx-background-color: #F1F1F1; -fx-background-radius: 6; -fx-border-color: #F2DDD0; -fx-border-radius: 6; -fx-padding: 9 10 9 10; -fx-font-size: 12px; -fx-text-fill: #8A7A72;" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;" text="Marca" />
                            <TextField fx:id="txtMarca" promptText="Nombre de la marca" style="-fx-background-color: #FFF6EC; -fx-background-radius: 6; -fx-border-color: #F2DDD0; -fx-border-radius: 6; -fx-padding: 9 10 9 10; -fx-font-size: 12px;" />
                        </VBox>
                    </HBox>

                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;" text="Categoría" />
                            <ComboBox fx:id="cmbCategoria" maxWidth="Infinity" prefWidth="200" promptText="Seleccionar categoría" style="-fx-background-color: #FFF6EC; -fx-background-radius: 6; -fx-border-color: #F2DDD0; -fx-border-radius: 6; -fx-font-size: 12px;" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;" text="Precio" />
                            <TextField fx:id="txtPrecio" style="-fx-background-color: #FFF6EC; -fx-background-radius: 6; -fx-border-color: #F2DDD0; -fx-border-radius: 6; -fx-padding: 9 10 9 10; -fx-font-size: 12px;" text="\$ 49900" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;" text="Stock" />
                            <TextField fx:id="txtStock" promptText="0" style="-fx-background-color: #FFF6EC; -fx-background-radius: 6; -fx-border-color: #F2DDD0; -fx-border-radius: 6; -fx-padding: 9 10 9 10; -fx-font-size: 12px;" />
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;" text="Descripción" />
                        <TextArea fx:id="txtDescripcion" prefHeight="72" style="-fx-background-color: #FFF6EC; -fx-background-radius: 6; -fx-border-color: #F2DDD0; -fx-border-radius: 6; -fx-font-size: 12px;" text="cobertura natural y acabado ligero" wrapText="true" />
                    </VBox>
                </VBox>

                <!-- COLUMNA DERECHA - FOTO + DISPONIBLE -->
                <VBox spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;" text="Foto del producto" />
                    <VBox alignment="CENTER" prefHeight="125" spacing="6" style="-fx-background-color: #FFF6EC; -fx-background-radius: 6; -fx-border-color: #F2DDD0; -fx-border-style: dashed; -fx-border-radius: 6;">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #8A7A72;" text="Sin imagen guardada" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #B0A29A;" text="Imagen actual del producto" />
                    </VBox>
                    <Button fx:id="btnSeleccionarFoto" maxWidth="Infinity" onAction="#cambiarFotoVistaImagen" prefWidth="300" style="-fx-background-color: #FFF6EC; -fx-background-radius: 6; -fx-border-color: #F2DDD0; -fx-border-radius: 6; -fx-text-fill: #7A1C33; -fx-font-size: 11px; -fx-padding: 9 10 9 10; -fx-cursor: hand;" text="Seleccionar fotografía" />
                    <VBox spacing="4">
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;" text="Cambiar imagen mediante enlace" />
                        <TextField fx:id="txtUrlImagen" promptText="Pega el nuevo enlace de imagen" style="-fx-background-color: #FFF6EC; -fx-background-radius: 6; -fx-border-color: #F2DDD0; -fx-border-radius: 6; -fx-padding: 9 10 9 10; -fx-font-size: 11px;" />
                    </VBox>
                    <VBox spacing="2" style="-fx-background-color: #FFF6EC; -fx-background-radius: 6; -fx-padding: 10 12 10 12;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;" text="Disponible" />
                            <CheckBox fx:id="chkDisponible" selected="true" />
                        </HBox>
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #8A7A72;" text="Disponible para la venta" />
                    </VBox>
                </VBox>
            <rowConstraints>
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <!-- ETIQUETAS + AGREGAR - IGUAL A LA FOTO -->
            <GridPane hgap="22">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="66" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="34" />
                </columnConstraints>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;" text="Etiquetas" />
                    <TextField fx:id="txtEtiquetas" promptText="Escribe las etiquetas del producto" style="-fx-background-color: #FFF6EC; -fx-background-radius: 6; -fx-border-color: #F2DDD0; -fx-border-radius: 6; -fx-padding: 9 10 9 10; -fx-font-size: 12px;" />
                    <!-- SCROLL LATERAL DE CUADRITOS -->
                    <ScrollPane fx:id="scrollEtiquetas" fitToHeight="true" fitToWidth="false" hbarPolicy="AS_NEEDED" pannable="true" prefHeight="48" style="-fx-background-color: #FFF6EC; -fx-border-color: #F2DDD0; -fx-border-radius: 6; -fx-background-radius: 6;" vbarPolicy="NEVER">
                        <HBox fx:id="hboxEtiquetas" alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #FFF6EC; -fx-padding: 8;" />
                    </ScrollPane>
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #8A7A72;" text="Separa las etiquetas con comas." />
                </VBox>
                <VBox alignment="BOTTOM_LEFT" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Button fx:id="btnAgregarEtiqueta" onAction="#etiquetas" style="-fx-background-color: #F0658C; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 9 28 9 28; -fx-cursor: hand;" text="Agregar" />
                </VBox>
            <rowConstraints>
               <RowConstraints />
            </rowConstraints>
            </GridPane>
        </VBox>

        <!-- BOTONES FINALES - IGUAL A LA FOTO -->
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-background-color: white; -fx-padding: 14 18 18 18;">
            <Button fx:id="btnCancelar" onAction="#volver" style="-fx-background-color: white; -fx-border-color: #E8A0B5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #7A1C33; -fx-font-size: 12px; -fx-padding: 8 20 8 20; -fx-cursor: hand;" text="Cancelar" />
            <Button fx:id="btnGuardar" onAction="#guardarCambios" style="-fx-background-color: #F0658C; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 20 8 20; -fx-cursor: hand;" text="Guardar cambios" />
        </HBox>
    </VBox>
</ScrollPane>
